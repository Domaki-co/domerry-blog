# 环境变量示例：把下面的占位值替换成你自己的配置，真实值请写入 .env.local（已被 .gitignore 的 *.local 忽略）。
# .env.development / .env.production 都在 git 跟踪范围内，不要往里写真实域名与密钥。
# 仓库内的默认值一律是占位值（your-domain.example / your-cdn.example）。

# 开发环境
VITE_APP_PORT = 3001
VITE_APP_API_URL = 'http://localhost:8900'

# 开发服务器监听地址：默认 localhost（仅本机可访问），不要为了图方便长期设成 0.0.0.0，
# 否则同网段任何主机都能访问你的开发服务与本地代理；确实需要局域网/真机调试时再临时设为 0.0.0.0。
# VITE_APP_DEV_HOST = '0.0.0.0'

# 站点域名（替换点 1）：前端接口地址与 WebSocket 地址
# 例：https://blog.example.com
VITE_APP_BASE_API = 'https://your-domain.example/doma'
VITE_APP_WEBSOCKET_API = 'wss://your-domain.example/doma/websocket/'

# 后台管理端登录地址（替换点 2）
VITE_APP_ADMIN_URL = "https://admin.your-domain.example/login"

# 图片 CDN 前缀（替换点 3）：对象存储 / MinIO / 七牛等对外访问域名
# 例：https://cdn.example.com
VITE_APP_LOGO= "/logo.svg"


# 音乐接口（原替换点 4 已移除）：`src/api/music.js` 改为请求后端代理 /api/music/**，
# 第三方地址与 key 由后端从字典读取（dictType `music_api`），在后台管理端的字典管理里配置，前端不再需要环境变量。

# 站点展示信息
VITE_APP_TITLE= "Domerry 博客 - 一个专注于技术分享的博客平台"
VITE_APP_KEYWORDS= "博客,开源博客,vue博客"
VITE_APP_DESCRIPTION = "一个专注于技术分享的博客平台,提供大家以共同学习,乐于分享,拥抱开源的价值观进行学习交流"

# 标签云最多展示多少个标签；只统计有关联文章的，并按文章数倒序（0 = 不限，默认 20）
# 见 src/config/index.js 与 src/utils/tags.js
# VITE_TAG_DISPLAY_LIMIT = 20
