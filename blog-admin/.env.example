# 环境变量示例：复制为 .env.development / .env.production 后，把下面的占位值替换成你自己的配置。
# 仓库内的默认值一律是占位值（your-domain.example / your-cdn.example），请勿把真实域名提交进仓库。

# 开发环境
VITE_APP_PORT = 30001
VITE_APP_API_URL = http://localhost:8900/

# 后台接口地址（替换点 1）：生产环境直连后端，不走代理
# 例：https://admin.example.com/doma
VITE_APP_BASE_API = 'https://admin.your-domain.example/doma'

# 图片 CDN 前缀（替换点 2）：对象存储 / MinIO / 七牛等对外访问域名
# 例：https://cdn.example.com
VITE_APP_LOGO= "/logo.svg"


# 站点展示信息
VITE_APP_TITLE= "Domerry 博客"
VITE_APP_KEYWORDS= "博客,开源博客,vue博客"
VITE_APP_DESCRIPTION = "一个专注于技术分享的博客平台,提供大家以共同学习,乐于分享,拥抱开源的价值观进行学习交流"
