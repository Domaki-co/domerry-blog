## 开发环境
NODE_ENV='development'

# 应用端口
VITE_APP_PORT = 30001

# 代理前缀
VITE_APP_BASE_API = '/api'

# 开发接口地址
 VITE_APP_API_URL = http://localhost:8900/

 VITE_APP_TITLE= "Domerry 博客"

