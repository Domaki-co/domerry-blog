# deploy/mac/allinone.sh 共用的本地配置模板。
# 用法：复制为同目录下的 deploy.env（已 gitignore，不会入库）后填写真实值。
# 脚本用法：
#   ./allinone.sh                # 等价于 all：web + admin + back
#   ./allinone.sh admin|web|back # 只发某一端，可任意组合
#   ./allinone.sh all --dry-run  # 只打印将执行的命令
# 命令行环境变量优先于 deploy.env，例如：
#   FRONTEND_SERVER_HOST=your-server.example ./allinone.sh admin
# 注意：本文件是入库模板，只留空值/占位值，真实主机、账号、密码一律写在 deploy.env 里。

# 前端发布目标（web / admin）
FRONTEND_SERVER_HOST=
FRONTEND_SERVER_USER=root

# 后端发布目标（back）
BACKEND_SERVER_HOST=
BACKEND_SERVER_USER=

# SSH 密码可选：推荐配置公钥免密；留空则执行时交互输入
# REMOTE_PASSWORD=

# 可选覆盖：远端目录（默认值见下）
# ADMIN_REMOTE_DIR=/mydata/nginx/html/blog/admin
# WEB_REMOTE_DIR=/mydata/nginx/html/blog/web
# REMOTE_JAR_DIR=/opt/domerry/blog
